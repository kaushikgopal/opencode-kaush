{
  "name": "opencode-kaush",
  "version": "0.0.0",
  "private": true,
  "description": "Composable plugins for the OpenCode coding agent",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "check": "npm run format:check && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
